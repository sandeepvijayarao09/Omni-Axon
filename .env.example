# Copy to .env and fill in. Everything here is read by server.ts only;
# none of it is bundled into the browser build.

# Required for chat, workflows and AI agent generation.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3-flash-preview).
GEMINI_MODEL=

# Optional: Google OAuth client for the Drive (read) and Docs (write) tools.
# Create a "Web application" OAuth client in Google Cloud Console and add
# <APP_URL>/api/auth/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of the app, used to build the OAuth redirect URI.
# If unset, the server derives it from the request host.
APP_URL=http://localhost:3000

# Port for the Express server (default: 3000).
PORT=3000
